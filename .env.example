# Copy this file to .env and fill in real values. NEVER commit the real .env file.

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/fooddelivery

# JWT secret - use a long random string (e.g. generate with: openssl rand -hex 32)
JWT_SECRET=replace_this_with_a_long_random_string

# Server port
PORT=5000

# Admin seed account (used only by seed.js to create ONE admin for testing/review)
ADMIN_SEED_NAME=Admin
ADMIN_SEED_EMAIL=admin@test.com
ADMIN_SEED_PASSWORD=Demo@12345

# Node environment
NODE_ENV=development

# Allowed frontend origin (for CORS) - set to your deployed frontend URL in production
CLIENT_ORIGIN=http://localhost:3000
